{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "arena",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "arena.py",
        "--port",
        "8000"
      ],
      "port": 8000
    },
    {
      "name": "replays",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8765",
        "--bind",
        "127.0.0.1",
        "--directory",
        "examples"
      ],
      "port": 8765
    },
    {
      "name": "training",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "rl/dashboard.py",
        "--port",
        "8090"
      ],
      "port": 8090
    }
  ]
}
